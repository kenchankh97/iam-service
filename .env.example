# =============================================================================
# Keycloak IAM Service - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values

# =============================================================================
# Database Configuration (Required)
# =============================================================================
# Keycloak requires a PostgreSQL database

# Database type
KC_DB=postgres

# JDBC URL for PostgreSQL connection
# For Railway: jdbc:postgresql://${{Postgres.PGHOST}}:${{Postgres.PGPORT}}/${{Postgres.PGDATABASE}}
# For local: jdbc:postgresql://localhost:5432/keycloak
KC_DB_URL=jdbc:postgresql://localhost:5432/keycloak

# Database credentials
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=keycloak

# =============================================================================
# Hostname Configuration (Required for Production)
# =============================================================================

# The hostname where Keycloak will be accessible
# For Railway: ${{RAILWAY_PUBLIC_DOMAIN}}
# For local: localhost
KC_HOSTNAME=localhost

# Set to false to allow access from any host during development
KC_HOSTNAME_STRICT=false

# =============================================================================
# Admin User (Required for first startup)
# =============================================================================
# These create the initial admin user - only used on first boot

KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!

# =============================================================================
# HTTP/HTTPS Configuration
# =============================================================================

# Enable HTTP (required when behind a reverse proxy like Railway)
KC_HTTP_ENABLED=true

# Port for HTTP (Railway sets PORT automatically)
KC_HTTP_PORT=8080

# Proxy headers (required for Railway)
KC_PROXY_HEADERS=xforwarded

# =============================================================================
# Features
# =============================================================================

# Enable health endpoint
KC_HEALTH_ENABLED=true

# Enable metrics endpoint
KC_METRICS_ENABLED=true

# =============================================================================
# OAuth2/OIDC Applications (Configured in Keycloak Admin UI)
# =============================================================================
# After Keycloak is running, create these in the admin console:
#
# 1. Create a Realm: "attendance"
# 2. Create a Client: "attendance-app"
#    - Client Protocol: openid-connect
#    - Access Type: confidential
#    - Valid Redirect URIs:
#      - https://your-attendance-app.railway.app/api/auth/callback
#      - http://localhost:5173/auth/callback
#      - attendance://callback (mobile app)
#    - Web Origins: + (allow all origins from redirect URIs)
#
# 3. Create Roles in the Realm:
#    - admin
#    - staff
#    - location
#
# 4. Create Groups (optional):
#    - attendance-admins (assign admin role)
#    - attendance-staff (assign staff role)
#    - attendance-locations (assign location role)
