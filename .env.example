# =============================================================================
# Authentik IAM Service - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values

# =============================================================================
# Core Authentik Settings (Required)
# =============================================================================

# Secret key for Authentik - generate with: openssl rand -base64 36
AUTHENTIK_SECRET_KEY=

# =============================================================================
# PostgreSQL Database (Required)
# =============================================================================
# For Railway: These are automatically set when you add a PostgreSQL service
# For self-hosted: Configure your PostgreSQL connection

PG_PASS=
PG_USER=authentik
PG_DB=authentik

# Railway PostgreSQL variables (auto-populated by Railway)
# PGHOST=
# PGPORT=5432
# PGUSER=
# PGPASSWORD=
# PGDATABASE=

# =============================================================================
# Redis (Required)
# =============================================================================
# For Railway: Add Redis service and set REDIS_HOST
# For self-hosted: Redis is included in docker-compose

REDIS_HOST=redis

# Railway Redis variables (if using Railway Redis)
# REDIS_URL=

# =============================================================================
# Email Configuration (Optional)
# =============================================================================
# Required for password reset emails and notifications

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_FROM=noreply@yourdomain.com

# =============================================================================
# Server Configuration
# =============================================================================

# Port for Authentik server (Railway sets this automatically)
AUTHENTIK_PORT=9000
AUTHENTIK_PORT_HTTPS=9443

# Public URL where Authentik is accessible
# AUTHENTIK_HOST=https://auth.yourdomain.com

# =============================================================================
# OAuth2/OIDC Applications
# =============================================================================
# These are configured in Authentik Admin UI, but documented here for reference

# Attendance System Application
# Client ID: attendance-app
# Application Slug: attendance-system
# Redirect URIs:
#   - https://your-attendance-app.railway.app/api/auth/callback
#   - http://localhost:5173/auth/callback
#   - attendance://callback (mobile app)
